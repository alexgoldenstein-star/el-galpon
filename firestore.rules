rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mails administradores (mismos que en firebase-config.js), en minúsculas.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'alexgoldenstein@hotmail.com'
        ];
    }

    // Datos del sitio: cualquiera los lee, solo administradores los cambian.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: cualquiera puede registrar uno nuevo (con formato controlado);
    // solo administradores los ven y cambian de estado.
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'barrio', 'items', 'total', 'status', 'createdAt'])
        && request.resource.data.status == 'nuevo'
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.barrio is string && request.resource.data.barrio.size() <= 80
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.createdAt == request.time;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
