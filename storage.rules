rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function email() {
      return request.auth.token.email.lower();
    }
    // Dueños: mismos mails que en firebase-config.js y firestore.rules.
    function isOwner() {
      return email() in [
        'alexgoldenstein@hotmail.com'
      ];
    }
    // Equipo con permiso de carga (administrador o carga de productos). Los vendedores no suben fotos.
    function isStaff() {
      return firestore.exists(/databases/(default)/documents/team/$(email()))
        && firestore.get(/databases/(default)/documents/team/$(email())).data.role in ['admin', 'editor'];
    }

    // Fotos: cualquiera las ve; dueños y equipo las suben (imágenes de hasta 3 MB).
    match /img/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && (isOwner() || isStaff())
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
